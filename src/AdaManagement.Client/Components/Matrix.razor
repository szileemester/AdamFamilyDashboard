@* Eisenhower mátrix: 2×2 panel kártyákkal (telefonon függőleges mini-kártyák). *@
@implements IDisposable
@inject ApiClient Api
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject UndoService Undo
@inject IJSRuntime JS

    @* ---------- 2×2 panel kártyákkal. Egérrel natív drag & drop (MudBlazor); érintőképernyőn a natív húzás
         ki van kapcsolva (ott görgetni kell tudni a kártyákon), helyette interactions.js hosszú nyomásos húzása hívja a MoveTo-t. ---------- *@
    <MudDropContainer T="TaskDto" @ref="_drop" Items="Tasks" ItemsSelector="@((t, zone) => Quadrants.Of(t.IsImportant, t.IsUrgent).Id == zone)"
                      ItemDropped="OnDropped" ItemDisabled="@(_ => ReadOnly || _touch)">
        <ChildContent>
            <div class="m-grid">
            @foreach (var q in Quadrants.All)
            {
                var count = ItemsOf(q).Count;
                <section class="@($"m-quad m-card-{q.Id}")" data-quad="@q.Id">
                    <div class="m-row-head">
                        <div class="@($"q-head {q.ColorClass}")">
                            @foreach (var icon in q.FlagIcons) { <MudIcon Icon="@icon" /> }
                            <span class="t-full">@q.Title</span><span class="t-short">@q.ShortTitle</span>
                            <span class="m-count">@count</span>
                        </div>
                        <span class="m-row-sub">@q.Subtitle</span>
                    </div>
                    <div class="m-row-body">
                        <MudDropZone T="TaskDto" Identifier="@q.Id" Class="m-track" />
                        @if (count == 0)
                        {
                            <div class="m-empty">Üres</div>
                        }
                    </div>
                </section>
            }
            </div>
        </ChildContent>
        <ItemRenderer>
            <TaskCard Task="context" Today="Today" ReadOnly="ReadOnly" OnComplete="Complete" OnEdit="Edit" />
        </ItemRenderer>
    </MudDropContainer>

@code {
    [Parameter, EditorRequired] public List<TaskDto> Tasks { get; set; } = [];
    [Parameter] public DateOnly Today { get; set; }
    /// <summary>Gyorsítótárazott (még nem friss) adatnál nem lehet szerkeszteni.</summary>
    [Parameter] public bool ReadOnly { get; set; }
    /// <summary>Bármilyen változás után: a szülő újratölti a dashboardot.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    private MudDropContainer<TaskDto>? _drop;
    private DotNetObjectReference<Matrix>? _self;
    private bool _touch;         // érintőképernyő: saját (JS) húzás a natív helyett
    private bool _needsRefresh = true;

    private List<TaskDto> ItemsOf(QuadrantInfo q) => Tasks.Where(t => t.IsImportant == q.Important && t.IsUrgent == q.Urgent).ToList();

    public void Dispose()
    {
        if (_self is null) return;
        _ = JS.InvokeVoidAsync("adaDnd.unregister", _self).AsTask().ContinueWith(_ => _self.Dispose());
    }

    protected override void OnParametersSet() => _needsRefresh = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Érintős húzás bekötése; érintőképernyőn (coarse pointer) a natív húzás kikapcsol.
            _self = DotNetObjectReference.Create(this);
            _touch = await JS.InvokeAsync<bool>("adaDnd.register", _self);
            if (_touch)
            {
                _needsRefresh = true;
                StateHasChanged();
                return;
            }
        }

        // A drop container csak a zónák regisztrációja után tudja szétosztani az elemeket (MudHidden miatt később jön létre).
        if (_needsRefresh && _drop is not null)
        {
            _needsRefresh = false;
            _drop.Refresh();
        }
    }

    /// <summary>Érintős húzás vége (interactions.js): a feladat átkerül a cél negyedbe.</summary>
    [JSInvokable]
    public async Task MoveTo(int taskId, string quadrantId)
    {
        var task = Tasks.FirstOrDefault(t => t.Id == taskId);
        if (task is null || ReadOnly) return;
        var q = Quadrants.ById(quadrantId);
        if (q.Important == task.IsImportant && q.Urgent == task.IsUrgent) return;
        await SetFlags((task, q.Important, q.Urgent));
    }

    private async Task Complete(TaskDto task)
    {
        if (task.RecurringTemplateId is { } templateId)
        {
            // Generált feladat: teljesítés párbeszédablakkal (dátum, megjegyzés, következő esedékesség).
            // Ha a sablon nem kérhető le (pl. hálózati hiba), nem megy tovább sima „Kész”-ként, mert az a sablont is léptetné.
            // Ha a sablon már nincs meg (404) vagy már egy másik alkalomnál tart, ez sima feladatként zárul.
            TemplateDto? template;
            try { template = await Api.GetAsync<TemplateDto>($"api/templates/{templateId}"); }
            catch (ApiException ex) when (ex.StatusCode == 404) { template = null; }
            catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); return; }
            if (template is not null && template.NextDueDate == task.OccurrenceDate)
            {
                if (!await CompleteOccurrenceDialog.ShowAsync(Dialogs, template, Today)) return;
                await OnChanged.InvokeAsync();
                Undo.Push($"Kész: {task.Title}", () => Api.PostAsync<TemplateDto>($"api/templates/{templateId}/undo-last"));
                return;
            }
        }

        if (!await Run(() => Api.PostAsync<TaskDto>($"api/tasks/{task.Id}/complete"))) return;
        Undo.Push($"Kész: {task.Title}", () => Api.PostAsync<TaskDto>($"api/tasks/{task.Id}/reopen"));
    }

    private async Task Edit(TaskDto task)
    {
        if (await TaskEditDialog.ShowAsync(Dialogs, task)) await OnChanged.InvokeAsync();
    }

    private Task SetFlags((TaskDto Task, bool Important, bool Urgent) x) =>
        Run(() => Api.PutAsync<TaskDto>($"api/tasks/{x.Task.Id}",
            new TaskEditDto(x.Task.Title, x.Task.Notes, x.Important, x.Urgent, x.Task.DueDate, x.Task.Icon)));

    private async Task OnDropped(MudItemDropInfo<TaskDto> info)
    {
        if (info.Item is null || info.DropzoneIdentifier is null) return;
        var q = Quadrants.ById(info.DropzoneIdentifier);
        if (q.Important == info.Item.IsImportant && q.Urgent == info.Item.IsUrgent) return;
        await SetFlags((info.Item, q.Important, q.Urgent));
    }

    private async Task<bool> Run(Func<Task> action)
    {
        try
        {
            await action();
            await OnChanged.InvokeAsync();
            return true;
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            return false;
        }
    }
}

@* Eisenhower mátrix. Telefonon a téma dönti el a nézetet (lista / bento csempék / fülek), desktopon 2×2 rács drag & droppal. *@
@implements IDisposable
@inject ApiClient Api
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject UndoSnackbar Undo
@inject ThemeService Themes

@* ---------- Gyors felvétel ---------- *@
<MudPaper Class="pa-2 mb-3" Elevation="0" Outlined="true">
    <div class="d-flex align-center gap-2">
        <MudTextField @bind-Value="_newTitle" Placeholder="@Placeholder" Variant="Variant.Text" Disabled="ReadOnly"
                      Immediate="true" OnKeyDown="OnQuickAddKey" Class="flex-grow-1 mt-0" />
        <button type="button" class="@($"flag-chip {(_newImportant ? "on-important" : "")}")" disabled="@ReadOnly"
                @onclick="() => _newImportant = !_newImportant" aria-pressed="@_newImportant">
            <MudIcon Icon="@(_newImportant ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarOutline)" /> Fontos
        </button>
        <button type="button" class="@($"flag-chip {(_newUrgent ? "on-urgent" : "")}")" disabled="@ReadOnly"
                @onclick="() => _newUrgent = !_newUrgent" aria-pressed="@_newUrgent">
            <MudIcon Icon="@(_newUrgent ? Icons.Material.Filled.Bolt : Icons.Material.Outlined.Bolt)" /> Sürgős
        </button>
        <MudIconButton Icon="@Icons.Material.Filled.Add" Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small"
                       Disabled="ReadOnly || string.IsNullOrWhiteSpace(_newTitle)" OnClick="QuickAdd" aria-label="Hozzáadás" />
    </div>
</MudPaper>

@* ---------- Telefon ---------- *@
<MudHidden Breakpoint="Breakpoint.SmAndDown" Invert="true">
    @switch (Themes.Current.Layout)
    {
        case MatrixLayout.Bento:
            <MudGrid Spacing="2">
                @foreach (var q in Quadrants.All)
                {
                    var items = ItemsOf(q);
                    var expanded = _expanded == q.Id;
                    <MudItem xs="@(expanded ? 12 : 6)">
                        <div class="@($"tile tile-{q.Id}")">
                            <QuadrantHeader Quadrant="q" Count="items.Count" BigCount="true" Short="!expanded" />
                            @foreach (var t in expanded ? items : items.Take(2))
                            {
                                <TaskRow @key="t.Id" Task="t" Today="Today" ReadOnly="ReadOnly" Compact="!expanded"
                                         OnComplete="Complete" OnEdit="Edit" OnFlags="SetFlags" />
                            }
                            @if (items.Count > 2 || expanded)
                            {
                                <div class="tile-more" @onclick="() => _expanded = expanded ? null : q.Id">
                                    @(expanded ? "Kevesebb" : $"+{items.Count - 2} további")
                                </div>
                            }
                            @if (items.Count == 0)
                            {
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">Üres</MudText>
                            }
                        </div>
                    </MudItem>
                }
            </MudGrid>
            break;

        case MatrixLayout.Fulek:
            <div class="q-tabs" role="tablist">
                @foreach (var q in Quadrants.All)
                {
                    var active = _tab == q.Id;
                    <button type="button" role="tab" aria-selected="@active" class="@($"q-tab {(active ? "active" : "")}")" style="@(active ? $"color:var(--{q.Id})" : null)"
                            @onclick="() => SelectTab(q)">
                        <span>@foreach (var icon in q.FlagIcons) { <MudIcon Icon="@icon" /> }</span>
                        <span>@q.ShortTitle · @ItemsOf(q).Count</span>
                    </button>
                }
            </div>
            var tabQ = Quadrants.ById(_tab);
            var tabItems = ItemsOf(tabQ);
            <MudPaper Class="pa-2" Elevation="0">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@tabQ.Title – @tabQ.Subtitle.ToLowerInvariant()</MudText>
                @foreach (var t in tabItems)
                {
                    <TaskRow @key="t.Id" Task="t" Today="Today" ReadOnly="ReadOnly" OnComplete="Complete" OnEdit="Edit" OnFlags="SetFlags" />
                }
                @if (tabItems.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary py-2">Ebben a negyedben nincs feladat.</MudText>
                }
            </MudPaper>
            break;

        default:
            @foreach (var q in Quadrants.All)
            {
                var items = ItemsOf(q);
                <div class="q-section">
                    <QuadrantHeader Quadrant="q" Count="items.Count" />
                    @foreach (var t in items)
                    {
                        <TaskRow @key="t.Id" Task="t" Today="Today" ReadOnly="ReadOnly" OnComplete="Complete" OnEdit="Edit" OnFlags="SetFlags" />
                    }
                    @if (items.Count == 0)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Üres</MudText>
                    }
                </div>
            }
            break;
    }
</MudHidden>

@* ---------- Desktop: 2×2 rács drag & droppal ---------- *@
<MudHidden Breakpoint="Breakpoint.SmAndDown">
    <MudDropContainer T="TaskDto" @ref="_drop" Items="Tasks" ItemsSelector="@((t, zone) => Quadrants.Of(t.IsImportant, t.IsUrgent).Id == zone)"
                      ItemDropped="OnDropped" ItemDisabled="@(_ => ReadOnly)">
        <ChildContent>
            <MudGrid Spacing="2">
                @foreach (var q in Quadrants.All)
                {
                    <MudItem xs="6">
                        <div class="@(Themes.Current.Layout == MatrixLayout.Bento ? $"tile quadrant tile-{q.Id}" : $"mud-paper pa-2 quadrant {q.CssClass}")">
                            <QuadrantHeader Quadrant="q" Count="ItemsOf(q).Count" ShowSubtitle="true" />
                            <MudDropZone T="TaskDto" Identifier="@q.Id" Class="flex-grow-1" />
                        </div>
                    </MudItem>
                }
            </MudGrid>
        </ChildContent>
        <ItemRenderer>
            <TaskRow Task="context" Today="Today" ReadOnly="ReadOnly" OnComplete="Complete" OnEdit="Edit" OnFlags="SetFlags" />
        </ItemRenderer>
    </MudDropContainer>
</MudHidden>

@code {
    [Parameter, EditorRequired] public List<TaskDto> Tasks { get; set; } = [];
    [Parameter] public DateOnly Today { get; set; }
    /// <summary>Gyorsítótárazott (még nem friss) adatnál nem lehet szerkeszteni.</summary>
    [Parameter] public bool ReadOnly { get; set; }
    /// <summary>Bármilyen változás után: a szülő újratölti a dashboardot.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    private MudDropContainer<TaskDto>? _drop;
    private string? _newTitle;
    private bool _newImportant;
    private bool _newUrgent;
    private string? _expanded;   // bento: kinyitott csempe
    private string _tab = "q1";  // fülek: kiválasztott negyed
    private bool _needsRefresh = true;

    private string Placeholder => Themes.Current.Layout == MatrixLayout.Fulek
        ? $"Új feladat → {Quadrants.Of(_newImportant, _newUrgent).ShortTitle}"
        : "Új feladat…";

    private List<TaskDto> ItemsOf(QuadrantInfo q) => Tasks.Where(t => t.IsImportant == q.Important && t.IsUrgent == q.Urgent).ToList();

    protected override void OnInitialized()
    {
        Themes.Changed += OnThemeChanged;
        SyncTabFlags();
    }

    private void OnThemeChanged()
    {
        _needsRefresh = true;
        SyncTabFlags();
        InvokeAsync(StateHasChanged);
    }

    /// <summary>Füles nézetben a gyors felvétel jelölései a kiválasztott fülét követik.</summary>
    private void SyncTabFlags()
    {
        if (Themes.Current.Layout == MatrixLayout.Fulek) SelectTab(Quadrants.ById(_tab));
    }

    public void Dispose() => Themes.Changed -= OnThemeChanged;

    protected override void OnParametersSet() => _needsRefresh = true;

    protected override void OnAfterRender(bool firstRender)
    {
        // A drop container csak a zónák regisztrációja után tudja szétosztani az elemeket (MudHidden miatt később jön létre).
        if (_needsRefresh && _drop is not null)
        {
            _needsRefresh = false;
            _drop.Refresh();
        }
    }

    /// <summary>Fül váltásakor a gyors felvétel is abba a negyedbe tesz.</summary>
    private void SelectTab(QuadrantInfo q)
    {
        _tab = q.Id;
        _newImportant = q.Important;
        _newUrgent = q.Urgent;
    }

    private async Task OnQuickAddKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await QuickAdd();
    }

    private async Task QuickAdd()
    {
        if (ReadOnly || string.IsNullOrWhiteSpace(_newTitle)) return;
        if (!await Run(() => Api.PostAsync<TaskDto>("api/tasks", new TaskEditDto(_newTitle.Trim(), null, _newImportant, _newUrgent, null)))) return;
        _newTitle = null;
        if (Themes.Current.Layout != MatrixLayout.Fulek) _newImportant = _newUrgent = false; // füleknél marad az aktuális negyed
    }

    private async Task Complete(TaskDto task)
    {
        if (task.RecurringTemplateId is { } templateId)
        {
            // Generált feladat: teljesítés párbeszédablakkal (dátum, megjegyzés, következő esedékesség).
            var template = await TryGet(() => Api.GetAsync<TemplateDto>($"api/templates/{templateId}"));
            if (template is not null && template.NextDueDate == task.OccurrenceDate)
            {
                if (!await CompleteOccurrenceDialog.ShowAsync(Dialogs, template, Today)) return;
                await OnChanged.InvokeAsync();
                Undo.Show($"Kész: {task.Title}", () => Api.PostAsync<TemplateDto>($"api/templates/{templateId}/undo-last"), () => OnChanged.InvokeAsync());
                return;
            }
        }

        if (!await Run(() => Api.PostAsync<TaskDto>($"api/tasks/{task.Id}/complete"))) return;
        Undo.Show($"Kész: {task.Title}", () => Api.PostAsync<TaskDto>($"api/tasks/{task.Id}/reopen"), () => OnChanged.InvokeAsync());
    }

    private async Task Edit(TaskDto task)
    {
        if (await TaskEditDialog.ShowAsync(Dialogs, task)) await OnChanged.InvokeAsync();
    }

    private Task SetFlags((TaskDto Task, bool Important, bool Urgent) x) =>
        Run(() => Api.PutAsync<TaskDto>($"api/tasks/{x.Task.Id}",
            new TaskEditDto(x.Task.Title, x.Task.Notes, x.Important, x.Urgent, x.Task.DueDate)));

    private async Task OnDropped(MudItemDropInfo<TaskDto> info)
    {
        if (info.Item is null || info.DropzoneIdentifier is null) return;
        var q = Quadrants.ById(info.DropzoneIdentifier);
        if (q.Important == info.Item.IsImportant && q.Urgent == info.Item.IsUrgent) return;
        await SetFlags((info.Item, q.Important, q.Urgent));
    }

    private async Task<bool> Run(Func<Task> action)
    {
        try
        {
            await action();
            await OnChanged.InvokeAsync();
            return true;
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            return false;
        }
    }

    private async Task<T?> TryGet<T>(Func<Task<T>> action) where T : class
    {
        try { return await action(); }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); return null; }
    }
}

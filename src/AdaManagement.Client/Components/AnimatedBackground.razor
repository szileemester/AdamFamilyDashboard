@* Teljes képernyős mozgó háttér (fényfoltok, parázs, kurzort követő reflektor) a dinamikus témákban (Piros, Kék).
   A statikus témákban (Sötét, Világos) nem fut. A rajzolás a wwwroot/js/ambient.js-ben van. *@
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ThemeService Themes

<canvas @ref="_canvas" class="ambient-bg" aria-hidden="true"></canvas>

@code {
    private ElementReference _canvas;
    private IJSObjectReference? _module;
    private string? _lastKey;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/ambient.js");
        Themes.Changed += Restart;
        await StartAsync();
    }

    private void Restart() => InvokeAsync(StartAsync);

    private async Task StartAsync()
    {
        if (_module is null) return;
        var key = Themes.Current.IsDynamic ? Themes.Current.Key : null;
        if (key == _lastKey) return; // ugyanaz: nem indítjuk újra
        _lastKey = key;
        try
        {
            if (key is null) await _module.InvokeVoidAsync("stop");
            else await _module.InvokeVoidAsync("start", _canvas, key);
        }
        catch (JSDisconnectedException) { }
    }

    public async ValueTask DisposeAsync()
    {
        Themes.Changed -= Restart;
        if (_module is null) return;
        try
        {
            await _module.InvokeVoidAsync("stop");
            await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
    }
}

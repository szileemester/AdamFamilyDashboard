@inject ApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject IJSRuntime JS

<MudDialog>
    <DialogContent>
        @* A foglalkozás sima szövegmező; a már felvett foglalkozásokat a böngésző natív javaslatlistája (datalist) ajánlja
           gépeléskor, így ugyanaz a csoport kerül elő. Nincs Required (üresen azonnal hibát mutatna): a kötelezőséget
           a letiltott Mentés adja. *@
        <MudTextField @bind-Value="_occupation" Label="Foglalkozás*" MaxLength="100" Immediate="true" AutoFocus="@(Tradesperson is null)"
                      UserAttributes="@(new() { ["list"] = "sz-occupations", ["autocomplete"] = "off" })" />
        <datalist id="sz-occupations">
            @foreach (var o in Occupations)
            {
                <option value="@o"></option>
            }
        </datalist>
        <MudTextField @bind-Value="_name" Label="Név" Required="true" RequiredError="Add meg a nevet." MaxLength="200" />
        <MudTextField @bind-Value="_phone" Label="Telefonszám" InputType="InputType.Telephone" MaxLength="50" Immediate="true"
                      Error="@(PhoneError is not null)" ErrorText="@PhoneError" AdornmentIcon="@Icons.Material.Filled.Phone" Adornment="Adornment.Start" />
        <MudTextField @bind-Value="_email" Label="E-mail-cím" InputType="InputType.Email" MaxLength="254" Immediate="true"
                      Error="@(EmailError is not null)" ErrorText="@EmailError" AdornmentIcon="@Icons.Material.Filled.Email" Adornment="Adornment.Start" />
        <MudTextField @bind-Value="_website" Label="Weboldal" InputType="InputType.Url" MaxLength="500" Immediate="true" Placeholder="pl. szaki.hu"
                      Error="@(WebsiteError is not null)" ErrorText="@WebsiteError" AdornmentIcon="@Icons.Material.Filled.Language" Adornment="Adornment.Start" />
        <MudTextField @bind-Value="_notes" Label="Megjegyzés (pl. ki ajánlotta, mit csinált)" Lines="3" Sizing="InputSizing.Auto" MaxLines="8" MaxLength="2000" />
    </DialogContent>
    <DialogActions>
        @* Telefonon (sm alatt) a Törlés és a Másolás csak ikon, hogy a négy gomb elférjen egy sorban. *@
        @if (Tradesperson is not null)
        {
            <MudButton Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="Delete" Class="d-none d-sm-flex">Törlés</MudButton>
            <MudIconButton Color="Color.Error" Icon="@Icons.Material.Filled.Delete" OnClick="Delete" Class="d-sm-none" aria-label="Törlés" />
        }
        <MudButton StartIcon="@Icons.Material.Filled.ContentCopy" OnClick="Copy" Disabled="@(!HasCopyContent)" Class="d-none d-sm-flex">Másolás</MudButton>
        <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" OnClick="Copy" Disabled="@(!HasCopyContent)" Class="d-sm-none" aria-label="Másolás" />
        <MudSpacer />
        <MudButton OnClick="() => MudDialog.Cancel()">Mégse</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save" Disabled="!CanSave">Mentés</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public TradespersonDto? Tradesperson { get; set; }
    [Parameter] public IReadOnlyList<string> Occupations { get; set; } = [];

    private string? _occupation, _name, _phone, _email, _website, _notes;
    private bool _busy;

    private string? PhoneError => string.IsNullOrWhiteSpace(_phone) || ContactLinks.IsValidPhone(_phone) ? null : "Csak számjegy, szóköz, +, -, / és zárójel; legalább 6 számjegy.";
    private string? EmailError => string.IsNullOrWhiteSpace(_email) || ContactLinks.IsValidEmail(_email) ? null : "Nem tűnik e-mail-címnek.";
    private string? WebsiteError => string.IsNullOrWhiteSpace(_website) || ContactLinks.WebsiteUrl(_website) is not null ? null : "Nem tűnik webcímnek.";

    private bool CanSave => !_busy && !string.IsNullOrWhiteSpace(_occupation) && !string.IsNullOrWhiteSpace(_name)
                            && PhoneError is null && EmailError is null && WebsiteError is null;

    public static async Task<bool> ShowAsync(IDialogService dialogs, TradespersonDto? tradesperson, IReadOnlyList<string> occupations)
    {
        var parameters = new DialogParameters<TradespersonEditDialog>
        {
            { x => x.Tradesperson, tradesperson },
            { x => x.Occupations, occupations },
        };
        var dialog = await dialogs.ShowAsync<TradespersonEditDialog>(tradesperson is null ? "Új szaki" : "Szaki", parameters);
        return await dialog.Result is { Canceled: false };
    }

    protected override void OnInitialized()
    {
        if (Tradesperson is not { } t) return;
        (_occupation, _name, _phone, _email, _website, _notes) = (t.Occupation, t.Name, t.Phone, t.Email, t.Website, t.Notes);
    }

    /// <summary>
    /// A másolandó mezők, ahogy most az ablakban állnak (mentés nélkül is). A címkék szándékosan rövidebbek
    /// a mezőcímkéknél: a vágólapra tömör „Telefon: …” sorok kerülnek.
    /// </summary>
    private (string Label, string? Value)[] CopyFields =>
    [
        ("Foglalkozás", _occupation), ("Név", _name), ("Telefon", _phone),
        ("E-mail", _email), ("Weboldal", _website), ("Megjegyzés", _notes),
    ];

    private bool HasCopyContent => CopyFields.Any(x => !string.IsNullOrWhiteSpace(x.Value));

    /// <summary>A kitöltött mezők „Címke: érték” soronként.</summary>
    private string CopyText => string.Join("\n", CopyFields
        .Where(x => !string.IsNullOrWhiteSpace(x.Value))
        .Select(x => $"{x.Label}: {x.Value!.Trim()}"));

    private async Task Copy()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", CopyText);
            Snackbar.Add("Az adatok a vágólapra kerültek.", Severity.Success);
        }
        catch { Snackbar.Add("Nem sikerült a vágólapra másolni.", Severity.Error); }
    }

    private async Task Save()
    {
        _busy = true;
        try
        {
            var dto = new TradespersonEditDto(_occupation!.Trim(), _name!.Trim(), _phone, _email, _website, _notes);
            if (Tradesperson is null) await Api.PostAsync<TradespersonDto>("api/tradespeople", dto);
            else await Api.PutAsync<TradespersonDto>($"api/tradespeople/{Tradesperson.Id}", dto);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _busy = false; }
    }

    private async Task Delete()
    {
        if (await Dialogs.ShowMessageBoxAsync("Törlés", $"Törlöd: {Tradesperson!.Name}?", yesText: "Törlés", cancelText: "Mégse") != true) return;
        try
        {
            await Api.DeleteAsync($"api/tradespeople/{Tradesperson.Id}");
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }
}

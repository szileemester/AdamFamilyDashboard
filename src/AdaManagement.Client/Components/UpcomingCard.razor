@* „Hamarosan” lista a kezdőkép jobb oldalán (telefonon alatta, vízszintesen görgetve): születésnapok (előrejelzési
   ablakon belül) és esedékes karbantartások. A két legközelebbi látszik, a többi egy „… és még X más” panelbe sűrítve,
   hogy a kezdőkép ne nőjön meg. *@
@{
    var all = Items();
    var shown = all.Count <= Max ? all : all.Take(Max - 1).ToList();
    var rest = all.Skip(shown.Count).ToList();
}
<aside class="hero-side">
    <div class="hero-side-title">Hamarosan</div>
    <div class="up-list">
        @if (all.Count == 0)
        {
            <span class="up-none">Nincs semmi a láthatáron</span>
        }
        @foreach (var i in shown)
        {
            <a class="up-item" href="@i.Href">
                <span class="up-emoji">@i.Emoji</span>
                <span class="up-name">@i.Name</span>
                <span class="@($"up-when {i.WhenClass}")">@Format.Relative(i.Days)</span>
            </a>
        }
        @if (rest.Count > 0)
        {
            <a class="up-item up-more" href="@(rest.Any(i => i.Emoji == "🎂") ? "szuletesnapok" : "ismetlodo")"
               title="@string.Join(", ", rest.Select(i => i.Name))">
                <span class="up-emoji">…</span>
                <span class="up-name">és még @rest.Count más</span>
                <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Class="up-when" />
            </a>
        }
    </div>
</aside>

@code {
    [Parameter] public IReadOnlyList<UpcomingBirthdayDto> Birthdays { get; set; } = [];
    [Parameter] public IReadOnlyList<UpcomingMaintenanceDto> Maintenance { get; set; } = [];

    /// <summary>Legfeljebb ennyi sor (ha több van, az utolsó helyén „… és még X más” áll).</summary>
    private const int Max = 3;

    private sealed record UpItem(string Emoji, string Name, int Days, string Href, string WhenClass);

    /// <summary>Karbantartások és születésnapok együtt, esedékesség szerint.</summary>
    private List<UpItem> Items() =>
        Maintenance.Select(m => new UpItem("🔧", m.Title, m.DaysUntil, "ismetlodo", m.DaysUntil < 0 ? "overdue" : ""))
            .Concat(Birthdays.Select(b => new UpItem("🎂", b.TurningAge is { } a ? $"{b.Name} ({a})" : b.Name, b.DaysUntil,
                "szuletesnapok", b.DaysUntil == 0 ? "today" : "")))
            .OrderBy(i => i.Days).ThenBy(i => i.Name)
            .ToList();
}

@* Rövid időjárás a kezdőképen: ma + 2 nap, közvetlenül az Open-Meteótól (a szerver ébredését nem várja meg).
   Kattintásra (vagy Enter/szóköz) felugró ablakban a heti előrejelzés nyílik meg. *@
@inject WeatherService Weather
@inject IDialogService Dialogs

@if (_forecast is null)
{
    <MudText Typo="Typo.caption" Class="mud-text-secondary">@(_error ?? "Időjárás betöltése…")</MudText>
    return;
}

@{
    var today = _forecast.Days[0];
    var (todayIcon, todayText) = WeatherService.Describe(today.Code);
    var label = Settings?.WeatherLabel ?? _forecast.Label;
}

<div class="weather-open" role="button" tabindex="0" title="Heti előrejelzés" aria-label="@($"Időjárás: {todayText}, {Math.Round(today.Max)} fok. Heti előrejelzés megnyitása")"
     @onclick="OpenWeek">
    <div class="hero-weather">
        <span style="font-size:1.3rem">@todayIcon</span>
        <b>@Math.Round(today.Max)°</b>
        <span>@todayText.ToLowerInvariant() · @label</span>
        <span class="hero-weather-next">
            @foreach (var (day, i) in Next())
            {
                <span>@ShortDay(day.Date, i) @WeatherService.Describe(day.Code).Icon @Math.Round(day.Max)°</span>
            }
        </span>
    </div>
</div>

@code {
    [Parameter] public SettingsDto? Settings { get; set; }

    private WeatherForecast? _forecast;
    private string? _error;
    private (double, double)? _loadedFor;

    protected override async Task OnParametersSetAsync()
    {
        if (Settings is null) return;
        var key = (Settings.Latitude, Settings.Longitude);
        if (_loadedFor == key) return;
        _loadedFor = key;

        _forecast = await Weather.GetCachedAsync(Settings.Latitude, Settings.Longitude);
        await Load(false);
    }

    private async Task Load(bool force)
    {
        if (Settings is null) return;
        try
        {
            _forecast = await Weather.GetAsync(Settings.WeatherLabel, Settings.Latitude, Settings.Longitude, force);
            _error = null;
        }
        catch
        {
            _error = "Az időjárás most nem érhető el.";
        }
    }

    private IEnumerable<(WeatherDay Day, int Index)> Next() => _forecast!.Days.Select((d, i) => (d, i)).Skip(1).Take(2);

    private Task OpenWeek() => Settings is null ? Task.CompletedTask : WeatherWeekDialog.ShowAsync(Dialogs, Settings);

    private static string ShortDay(DateOnly d, int i) => i == 1 ? "holnap" : d.ToString("ddd").ToLowerInvariant();
}

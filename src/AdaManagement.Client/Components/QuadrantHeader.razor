@* Negyed fejléce: ★/⚡ ikonok + cím + darabszám, a negyed színével. *@

<div class="@($"q-head {Quadrant.ColorClass}")">
    @foreach (var icon in Quadrant.FlagIcons)
    {
        <MudIcon Icon="@icon" />
    }
    <span>@(Short ? Quadrant.ShortTitle : Quadrant.Title)</span>
    @if (ShowSubtitle)
    {
        <MudText Typo="Typo.caption" Class="mud-text-secondary ml-1">@Quadrant.Subtitle</MudText>
    }
    @if (Count is { } c)
    {
        <span class="@(BigCount ? "tile-count" : "ml-1 mud-text-secondary")" style="@(BigCount ? "" : "font-weight:400;font-size:.8rem")">@c</span>
    }
</div>

@code {
    [Parameter, EditorRequired] public QuadrantInfo Quadrant { get; set; } = default!;
    [Parameter] public int? Count { get; set; }
    [Parameter] public bool ShowSubtitle { get; set; }
    [Parameter] public bool Short { get; set; }
    [Parameter] public bool BigCount { get; set; }
}

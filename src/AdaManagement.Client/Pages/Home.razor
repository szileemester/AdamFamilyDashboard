@page "/"
@inject ApiClient Api
@inject LocalCache Cache
@inject IDialogService Dialogs
@inject UndoService Undo
@implements IDisposable

<PageTitle>Adam's family dashboard</PageTitle>

@if (_data is null)
{
    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-2">@_error</MudAlert>
        <MudButton OnClick="Refresh" Variant="Variant.Outlined">Újra</MudButton>
    }
    else
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        <MudText Typo="Typo.caption">Kapcsolódás a szerverhez… (alvó szervernél ez fél percig is tarthat)</MudText>
    }
}
else
{
    @if (_stale)
    {
        <MudAlert Severity="@(_error is null ? Severity.Info : Severity.Warning)" Dense="true" Class="mb-2"
                  Icon="@Icons.Material.Filled.CloudSync">
            @if (_error is null)
            {
                <span>Mentett állapot, frissítés folyamatban… (addig csak olvasható)</span>
            }
            else
            {
                <span>Nem sikerült frissíteni: @_error</span>
                <MudButton Size="Size.Small" OnClick="Refresh" Class="ml-2">Újra</MudButton>
            }
        </MudAlert>
        <MudProgressLinear Indeterminate="@(_error is null)" Color="Color.Primary" Class="mb-2" />
    }

    var urgent = _tasks.Count(t => t.IsImportant && t.IsUrgent);
    var overdue = _tasks.Count(t => t.DueDate < _data.Today);
    <div class="@(_stale ? "stale" : "")">
        <section class="hero">
            <div class="hero-content">
                <div class="hero-kicker">@_data.Today.ToString("dddd · MMMM d.")</div>
                @* Tömör kezdőkép: a gombok a cím mellett (keskeny ablakban alá törnek) *@
                <div class="hero-head">
                    <h1 class="hero-title">@_cheer</h1>
                    <div class="hero-actions">
                        <button type="button" class="hero-btn primary" disabled="@_stale" @onclick="NewTask">
                            <MudIcon Icon="@Icons.Material.Filled.Add" /> Új feladat
                        </button>
                        <a class="hero-btn" href="ismetlodo"><MudIcon Icon="@Icons.Material.Outlined.EventRepeat" /> Ismétlődők</a>
                        <UndoButton Hero="true" />
                    </div>
                </div>
                <div class="hero-meta">
                    <span class="hero-stat"><b class="q-color-q1">@urgent</b> azonnali</span>
                    <span class="hero-stat"><b>@_tasks.Count</b> nyitott</span>
                    @if (overdue > 0) { <span class="hero-stat"><b class="overdue">@overdue</b> lejárt</span> }
                    <WeatherCard Settings="_data.Settings" />
                </div>
            </div>
            <UpcomingCard Birthdays="_data.Birthdays" Maintenance="_data.Maintenance" />
        </section>

        <Matrix Tasks="_tasks" Today="_data.Today" ReadOnly="_stale" OnChanged="Refresh" />
    </div>
}

@code {
    /// <summary>Kezdőkép: oldalbetöltésenként egy véletlen biztató üzenet.</summary>
    private static readonly string[] Cheers =
    [
        "Ma is jó napod lesz!",
        "Megy ez neked!",
        "Kis lépések, nagy eredmények.",
        "Egyszerre csak egy dolog.",
        "Minden kipipált feladat számít.",
        "Lendületben vagy!",
        "Jól haladsz, csak így tovább!",
        "A mai nap a tiéd.",
        "Kezdd a legfontosabbal!",
        "Ami ma kész, holnap nem nyomaszt.",
        "Nyugi, minden belefér.",
        "Szép munka eddig!",
        "Büszke lehetsz magadra.",
        "Egy lépés is haladás.",
        "Hiszek benned!",
        "Pihenni is ér.",
        "Ma te irányítasz.",
        "Lassan járj, tovább érsz.",
    ];
    private readonly string _cheer = Cheers[Random.Shared.Next(Cheers.Length)];

    /// <summary>Az „Új feladat” gomb a szerkesztő ablakot nyitja.</summary>
    private async Task NewTask()
    {
        if (await TaskEditDialog.ShowAsync(Dialogs, null)) await Refresh();
    }

    public void Dispose() => Undo.Undone -= OnUndone;

    // Visszavonás (pl. véletlen „Kész”) után a friss állapot kell.
    private async Task OnUndone()
    {
        await Refresh();
        await InvokeAsync(StateHasChanged);
    }

    private const string CacheKey = "ada.dashboard";
    private DashboardDto? _data;
    private List<TaskDto> _tasks = [];
    private bool _stale;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        Undo.Undone += OnUndone;

        // 1) Azonnal: az utolsó mentett állapot (csak olvasható).
        var cached = await Cache.GetAsync<DashboardDto>(CacheKey);
        if (cached is not null)
        {
            Set(cached);
            _stale = true;
            StateHasChanged();
        }

        // 2) Háttérben: friss adat (a szerver és az SQL akár percekig is ébredhet).
        await Refresh();
    }

    private async Task Refresh()
    {
        _error = null;
        try
        {
            var fresh = await Api.GetAsync<DashboardDto>("api/dashboard");
            Set(fresh);
            _stale = false;
            await Cache.SetAsync(CacheKey, fresh);
        }
        catch (ApiException ex) when (ex.Message == "Bejelentkezés szükséges.")
        {
            // átirányítás folyamatban
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            if (_data is not null) _stale = true;
        }
    }

    private void Set(DashboardDto d)
    {
        _data = d;
        _tasks = d.OpenTasks.ToList();
    }
}

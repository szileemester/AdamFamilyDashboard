@page "/szuletesnapok"
@inject ApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService Dialogs

<PageTitle>Születésnapok – Adam's family dashboard</PageTitle>

@* kezdőkép + „Hamarosan” kiemelt kártyák + a többi hónapok szerint, kisebb kártyákon. *@
<section class="hero sub-hero">
    <div class="hero-content">
        <div class="hero-kicker">Család és barátok</div>
        <div class="hero-head">
            <div class="sub-hero-name">
                <BackButton />
                <h1 class="hero-title">Születésnapok</h1>
            </div>
            <div class="hero-actions">
                <button type="button" class="hero-btn primary" @onclick="Add"><MudIcon Icon="@Icons.Material.Filled.Add" /> Új</button>
            </div>
        </div>
        @if (_items is { Count: > 0 })
        {
            var all = Sorted.ToList();
            var next = all[0];
            <div class="hero-meta">
                <span class="hero-stat"><b>@all.Count</b> születésnap</span>
                <span class="hero-stat"><b>@all.Count(b => b.Days <= Lookahead)</b> @Lookahead napon belül</span>
                <span class="hero-next">Következő: <b>@next.Item.Name</b> · @Format.Relative(next.Days)</span>
            </div>
        }
    </div>
</section>

@if (_items is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_items.Count == 0)
{
    <div class="sub-empty">Még nincs születésnap felvéve. Az „Új” gombbal veheted fel az elsőt.</div>
}
else
{
    var all = Sorted.ToList();
    var soon = all.Where(b => b.Days <= Lookahead).ToList();
    var later = all.Where(b => b.Days > Lookahead).ToList();

    @if (soon.Count > 0)
    {
        <h2 class="sub-section">Hamarosan <span class="m-count">@soon.Count</span></h2>
        <div class="bd-feature-grid">
            @foreach (var b in soon)
            {
                <article class="@($"bd-feature {(b.Days == 0 ? "today" : b.Days <= 7 ? "week" : "")}")" style="@($"--hue:{b.Item.Id * 47 % 360}")"
                         role="button" tabindex="0" aria-label="@($"{b.Item.Name} szerkesztése")"
                         @onclick="() => Edit(b.Item)">
                    <div class="bd-feature-art" aria-hidden="true"></div>
                    @if (b.Days == 0) { <span class="bd-feature-emoji" aria-hidden="true">🎉</span> }
                    <div class="bd-avatar">@Initials(b.Item.Name)</div>
                    <div class="bd-feature-body">
                        <div class="bd-name">@b.Item.Name</div>
                        <div class="bd-sub">@DateText(b.Item, b.Next)@(b.Age is { } a ? $" · {a} éves lesz" : "")</div>
                        @if (b.Item.Notes is { } n) { <div class="bd-notes">@n</div> }
                    </div>
                    <div class="bd-count">
                        @if (b.Days == 0)
                        {
                            <b>Ma!</b>
                        }
                        else if (b.Days == 1)
                        {
                            <b>Holnap</b>
                        }
                        else
                        {
                            <b>@b.Days</b><span>nap múlva</span>
                        }
                    </div>
                </article>
            }
        </div>
    }

    @foreach (var month in later.GroupBy(b => (b.Next.Year, b.Next.Month)))
    {
        <h2 class="sub-section">@Capital(BirthdayEditDialog.MonthName(month.Key.Month)) <span class="m-count">@month.Count()</span></h2>
        <div class="bd-grid">
            @foreach (var b in month)
            {
                <article class="bd-card" style="@($"--hue:{b.Item.Id * 47 % 360}")"
                         role="button" tabindex="0" aria-label="@($"{b.Item.Name} szerkesztése")"
                         @onclick="() => Edit(b.Item)">
                    <div class="bd-avatar">@Initials(b.Item.Name)</div>
                    <div class="bd-card-body">
                        <div class="bd-name">@b.Item.Name</div>
                        <div class="bd-sub">@DateText(b.Item, b.Next)@(b.Age is { } a ? $" · {a} éves lesz" : "")</div>
                    </div>
                    <div class="bd-days">@b.Days<span>nap</span></div>
                </article>
            }
        </div>
    }
}

@code {
    private List<BirthdayDto>? _items;
    private int Lookahead { get; set; } = 30;

    // A következő előfordulás szerinti sorrend (Feb 29 → nem szökőévben Feb 28), ugyanazzal a számolással, mint a szerver.
    private IEnumerable<(BirthdayDto Item, int Days, int? Age, DateOnly Next)> Sorted
    {
        get
        {
            var today = Format.Today;
            return _items!.Select(b =>
            {
                var next = BirthdayDates.NextOccurrence(b.Month, b.Day, today);
                return (b, next.DayNumber - today.DayNumber, BirthdayDates.TurningAge(b.Year, next), next);
            }).OrderBy(x => x.Item2).ThenBy(x => x.b.Name);
        }
    }

    /// <summary>„Kovács Anna” → „KA”; egyszavas névnél az első betű.</summary>
    private static string Initials(string name) =>
        string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpper(p[0])));

    private static string Capital(string s) => s.Length == 0 ? s : char.ToUpper(s[0]) + s[1..];

    /// <summary>Hónap, nap és a hét napja (pl. „március 3., kedd”).</summary>
    private static string DateText(BirthdayDto b, DateOnly next) =>
        $"{BirthdayEditDialog.MonthName(b.Month)} {b.Day}., {next.ToString("dddd")}";

    protected override async Task OnInitializedAsync()
    {
        await Load();
        // A „Hamarosan” határa a beállításokban megadott előrejelzés (a főoldal „Közelgő” sávjával egyezik).
        try { Lookahead = (await Api.GetAsync<SettingsDto>("api/settings")).BirthdayLookaheadDays; } catch { }
    }


    private async Task Load()
    {
        try { _items = await Api.GetAsync<List<BirthdayDto>>("api/birthdays"); }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); _items ??= []; }
    }

    private async Task Add()
    {
        if (await BirthdayEditDialog.ShowAsync(Dialogs, null)) await Load();
    }

    private async Task Edit(BirthdayDto b)
    {
        if (await BirthdayEditDialog.ShowAsync(Dialogs, b)) await Load();
    }
}

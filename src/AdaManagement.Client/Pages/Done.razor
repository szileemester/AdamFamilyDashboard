@page "/kesz"
@inject ApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject UndoService Undo
@implements IDisposable

<PageTitle>Kész feladatok – Adam's family dashboard</PageTitle>

@* kezdőkép kereséssel, alatta a kész feladatok plakát-kártyái a befejezés napja szerint csoportosítva. *@
<section class="hero sub-hero">
    <div class="hero-content">
        <div class="hero-kicker">Archívum</div>
        <div class="hero-head">
            <div class="sub-hero-name">
                <BackButton />
                <h1 class="hero-title">Kész feladatok</h1>
            </div>
        </div>
        @if (_items is { Count: > 0 })
        {
            var today = Format.Today;
            <div class="hero-meta">
                @* A szerver legfeljebb 200 elemet ad vissza (a legutóbbiakat): ennyinél „200+”. *@
                <span class="hero-stat"><b>@(_items.Count >= MaxItems ? $"{MaxItems}+" : _items.Count)</b> @(string.IsNullOrWhiteSpace(_query) ? "kész feladat" : "találat")</span>
                <span class="hero-stat"><b class="dn-ok">@_items.Count(t => DoneOn(t) == today)</b> ma</span>
                <span class="hero-stat"><b>@_items.Count(t => DoneOn(t) > today.AddDays(-7))</b> az elmúlt 7 napban</span>
            </div>
        }
        <MudTextField @bind-Value="_query" Placeholder="Keresés a kész feladatok között…" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      DebounceInterval="400" OnDebounceIntervalElapsed="_ => Load()" Immediate="true" Clearable="true"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Class="sub-search" UserAttributes="@(new() { ["aria-label"] = "Keresés a kész feladatok között" })" />
    </div>
</section>

@if (_items is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_items.Count == 0)
{
    <div class="sub-empty">@(string.IsNullOrWhiteSpace(_query) ? "Még nincs kész feladat." : "Nincs találat.")</div>
}
else
{
    @foreach (var group in _items.GroupBy(t => GroupName(DoneOn(t))))
    {
        <h2 class="sub-section">@group.Key <span class="m-count">@group.Count()</span></h2>
        <div class="rp-grid dn-grid">
            @foreach (var t in group)
            {
                var q = Quadrants.Of(t.IsImportant, t.IsUrgent);
                <article class="rp-card dn-card" style="@($"--hue:{t.Id * 47 % 360};--accent:var(--{q.Id})")">
                    <div class="rp-art" aria-hidden="true"></div>
                    <MudIcon Icon="@TaskIcons.For(t, q)" Class="rp-icon" aria-hidden="true" />
                    <div class="rp-main dn-main">
                        <div class="rp-badges">
                            <span class="m-badge ok"><MudIcon Icon="@Icons.Material.Filled.Check" /> Kész</span>
                            <span class="m-badge dn-quad">@q.ShortTitle</span>
                            @if (t.RecurringTemplateId is not null) { <span class="m-badge">Ismétlődő</span> }
                        </div>
                        <div class="rp-title">@t.Title</div>
                        <div class="rp-meta">
                            <span title="Befejezve"><MudIcon Icon="@Icons.Material.Outlined.TaskAlt" /> @Format.Stamp(Format.ToLocal(t.CompletedAt ?? t.CreatedAt))</span>
                            @if (t.DueDate is { } due)
                            {
                                <span title="Határidő" class="@(due < DoneOn(t) ? "dn-late" : "")"><MudIcon Icon="@Icons.Material.Outlined.Event" /> @Format.Date(due)</span>
                            }
                        </div>
                    </div>
                    <div class="rp-actions">
                        @if (t.ChecklistTotal > 0 || t.StoryCount > 0)
                        {
                            @* A teendők és a történet csak olvashatóan; szerkeszteni visszanyitás után lehet. *@
                            <button type="button" class="m-btn" title="Teendők és történet" aria-label="Teendők és történet" @onclick="() => Show(t)">
                                <MudIcon Icon="@Icons.Material.Filled.History" />
                            </button>
                        }
                        <button type="button" class="m-btn wide" title="Visszanyitás: visszakerül a mátrixba" @onclick="() => Reopen(t)">
                            <MudIcon Icon="@Icons.Material.Filled.Undo" /><span>Visszanyitás</span>
                        </button>
                        <button type="button" class="m-btn rp-delete" title="Végleges törlés" aria-label="Végleges törlés" @onclick="() => Delete(t)">
                            <MudIcon Icon="@Icons.Material.Outlined.DeleteForever" />
                        </button>
                    </div>
                </article>
            }
        </div>
    }
}

@code {
    private const int MaxItems = 200;
    private string? _query;
    private List<TaskDto>? _items;
    private int _loadVersion;   // gépelés közbeni keresésnél csak a legutolsó kérés eredménye számít

    private static DateOnly DoneOn(TaskDto t) => DateOnly.FromDateTime(Format.ToLocal(t.CompletedAt ?? t.CreatedAt));

    /// <summary>Csoport a befejezés napja szerint: Ma, Tegnap, Ezen a héten, utána hónaponként.</summary>
    private static string GroupName(DateOnly d)
    {
        var today = Format.Today;
        var ago = today.DayNumber - d.DayNumber;
        if (ago <= 0) return "Ma";
        if (ago == 1) return "Tegnap";
        if (ago < 7) return "Az elmúlt héten";
        var name = d.ToString("MMMM");
        name = char.ToUpper(name[0]) + name[1..];
        return d.Year == today.Year ? name : $"{d.Year}. {name}";
    }

    /// <summary>„ma 14:32”, „tegnap 9:05”, egyébként „nov. 3. 14:32”.</summary>
    protected override Task OnInitializedAsync()
    {
        Undo.Undone += OnUndone;
        return Load();
    }

    // A fejléc visszavonás-ikonja után a visszanyitott feladat eltűnik a listából.
    private async Task OnUndone()
    {
        await Load();
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Undo.Undone -= OnUndone;
    }

    private async Task Load()
    {
        var version = ++_loadVersion;
        try
        {
            var q = string.IsNullOrWhiteSpace(_query) ? "" : $"?q={Uri.EscapeDataString(_query.Trim())}";
            var items = await Api.GetAsync<List<TaskDto>>($"api/tasks/completed{q}");
            if (version == _loadVersion) _items = items;
        }
        catch (Exception ex)
        {
            if (version != _loadVersion) return;
            Snackbar.Add(ex.Message, Severity.Error);
            _items ??= [];
        }
    }

    private Task Show(TaskDto t) => TaskEditDialog.ShowAsync(Dialogs, t);

    private async Task Reopen(TaskDto t)
    {
        try { await Api.PostAsync<TaskDto>($"api/tasks/{t.Id}/reopen"); await Load(); }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task Delete(TaskDto t)
    {
        if (await Dialogs.ShowMessageBoxAsync("Végleges törlés", $"„{t.Title}” véglegesen törlődik. Ez nem vonható vissza.",
                yesText: "Törlés", cancelText: "Mégse") != true) return;
        try { await Api.DeleteAsync($"api/tasks/{t.Id}"); await Load(); }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }
}

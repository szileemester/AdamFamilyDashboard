@page "/beallitasok"
@inject ApiClient Api
@inject WeatherService Weather
@inject ISnackbar Snackbar
@inject ThemeService Themes
@implements IDisposable

<PageTitle>Beállítások – Adam's family dashboard</PageTitle>

<section class="hero sub-hero">
    <div class="hero-content">
        <div class="hero-kicker">Személyre szabás</div>
        <div class="hero-head">
            <div class="sub-hero-name">
                <BackButton />
                <h1 class="hero-title">Beállítások</h1>
            </div>
        </div>
        <div class="hero-meta">
            <span class="hero-stat">Téma: <b>@Themes.Current.Name</b></span>
            @if (_settings is not null)
            {
                <span class="hero-stat">Helyszín: <b>@_settings.WeatherLabel</b></span>
                <span class="hero-stat">Előrejelzés: <b>@_settings.BirthdayLookaheadDays</b> nap</span>
            }
        </div>
    </div>
</section>

@* Megjelenés: eszközönként, azonnal életbe lép (nem kell a Mentés gomb). Minden csempe a saját témájában rajzolja
   meg a kezdőkép kicsinyített mását (a téma CSS-változóit a csempe saját osztályai adják). *@
<section class="set-card set-wide">
    <div class="set-card-head">
        <span class="set-card-icon"><MudIcon Icon="@Icons.Material.Outlined.Palette" /></span>
        <div>
            <div class="set-card-title">Megjelenés</div>
            <div class="set-card-sub">Ezen az eszközön érvényes, azonnal életbe lép.</div>
        </div>
    </div>
    <div class="set-themes" role="radiogroup" aria-label="Téma">
        @foreach (var t in ThemeService.All)
        {
            var selected = Themes.Current.Id == t.Id;
            <button type="button" role="radio" aria-checked="@(selected ? "true" : "false")" tabindex="@(selected ? 0 : -1)"
                    class="@($"theme-tile theme-mozi theme-{t.Key} {(t.IsDynamic ? "tp-dynamic" : "")} {(selected ? "selected" : "")}")"
                    @onclick="() => Themes.SetThemeAsync(t.Id)">
                <span class="tp-preview" aria-hidden="true">
                    <span class="tp-kicker"></span>
                    <span class="tp-title"></span>
                    <span class="tp-btn"></span>
                    <span class="tp-cards">
                        <span style="--hue:0"></span><span style="--hue:200"></span><span style="--hue:120"></span>
                    </span>
                </span>
                <span class="tp-meta">
                    <span class="tp-name">@t.Name</span>
                    <span class="tp-tag">@(t.IsDynamic ? "Dinamikus" : "Statikus")</span>
                </span>
                <span class="tp-desc">@t.Description</span>
                @if (selected)
                {
                    <span class="tp-check"><MudIcon Icon="@Icons.Material.Filled.Check" /></span>
                }
            </button>
        }
    </div>
</section>

@if (_settings is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <div class="set-grid">
        <section class="set-card">
            <div class="set-card-head">
                <span class="set-card-icon"><MudIcon Icon="@Icons.Material.Outlined.WbSunny" /></span>
                <div>
                    <div class="set-card-title">Időjárás helyszíne</div>
                    <div class="set-card-sub">Ehhez a településhez kéri le az előrejelzést.</div>
                </div>
            </div>
            <div class="set-place">
                <MudIcon Icon="@Icons.Material.Filled.Place" />
                <div>
                    <div class="set-place-name">@_label</div>
                    <div class="set-place-coord">@_lat.ToString("0.####"), @_lon.ToString("0.####")</div>
                </div>
            </div>
            <div class="set-search">
                <MudTextField @bind-Value="_search" Placeholder="Település keresése…" OnKeyDown="SearchKey" Immediate="true"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                              Class="sub-search" UserAttributes="@(new() { ["aria-label"] = "Település keresése" })" />
                <button type="button" class="hero-btn" disabled="@string.IsNullOrWhiteSpace(_search)" @onclick="Search">Keresés</button>
            </div>
            @if (_places.Count > 0)
            {
                <div class="up-list set-results">
                    @foreach (var p in _places)
                    {
                        <button type="button" class="up-item" @onclick="() => Pick(p)">
                            <span class="up-emoji">📍</span>
                            <span class="up-name">@p.Display</span>
                        </button>
                    }
                </div>
            }
        </section>

        <section class="set-card">
            <div class="set-card-head">
                <span class="set-card-icon"><MudIcon Icon="@Icons.Material.Outlined.Cake" /></span>
                <div>
                    <div class="set-card-title">Születésnapok</div>
                    <div class="set-card-sub">Ennyi nappal előre jelenjen meg a „Hamarosan” listában.</div>
                </div>
            </div>
            <div class="set-chips" role="radiogroup" aria-label="Előrejelzés napokban">
                @foreach (var d in LookaheadPresets)
                {
                    <button type="button" role="radio" aria-checked="@(_lookahead == d ? "true" : "false")" tabindex="@(_lookahead == d || (d == LookaheadPresets[0] && !LookaheadPresets.Contains(_lookahead)) ? 0 : -1)"
                            class="@($"set-chip {(_lookahead == d ? "on" : "")}")" @onclick="() => _lookahead = d">@d nap</button>
                }
            </div>
            <MudNumericField @bind-Value="_lookahead" Label="Egyedi (nap)" Min="1" Max="366" Variant="Variant.Outlined" Margin="Margin.Dense" Class="set-number" />
        </section>
    </div>

    <div class="set-save">
        <button type="button" class="hero-btn primary" disabled="@(_busy || !Dirty)" @onclick="Save">
            <MudIcon Icon="@Icons.Material.Filled.Save" /> Mentés
        </button>
        @if (Dirty)
        {
            <span class="set-state">Nem mentett változás</span>
        }
        else if (_saved)
        {
            <span class="set-state ok"><MudIcon Icon="@Icons.Material.Filled.Check" /> Mentve</span>
        }
    </div>
}

@code {
    private static readonly int[] LookaheadPresets = [7, 14, 30, 60, 90];

    protected override void OnInitialized() => Themes.Changed += OnThemeChanged;
    private void OnThemeChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Themes.Changed -= OnThemeChanged;

    private SettingsDto? _settings;
    private string _label = "";
    private double _lat;
    private double _lon;
    private int _lookahead;
    private string? _search;
    private IReadOnlyList<GeoPlace> _places = [];
    private bool _busy;
    private bool _saved;

    /// <summary>Van-e a mentetthez képest eltérés (helyszín vagy előrejelzés).</summary>
    private bool Dirty => _settings is not null &&
        (_label != _settings.WeatherLabel || _lat != _settings.Latitude || _lon != _settings.Longitude || _lookahead != _settings.BirthdayLookaheadDays);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _settings = await Api.GetAsync<SettingsDto>("api/settings");
            (_label, _lat, _lon, _lookahead) = (_settings.WeatherLabel, _settings.Latitude, _settings.Longitude, _settings.BirthdayLookaheadDays);
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task SearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Search();
    }

    private async Task Search()
    {
        if (string.IsNullOrWhiteSpace(_search)) return;
        try
        {
            _places = await Weather.SearchPlacesAsync(_search.Trim());
            if (_places.Count == 0) Snackbar.Add("Nincs találat.", Severity.Info);
        }
        catch { Snackbar.Add("A keresés most nem érhető el.", Severity.Error); }
    }

    private void Pick(GeoPlace p)
    {
        (_label, _lat, _lon) = (p.Name, p.Latitude, p.Longitude);
        _places = [];
        _search = null;
    }

    private async Task Save()
    {
        _busy = true;
        try
        {
            _settings = await Api.PutAsync<SettingsDto>("api/settings", new SettingsDto(_label, _lat, _lon, _lookahead));
            _saved = true;   // felugró értesítés helyett a gomb mellett jelez
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _busy = false; }
    }
}

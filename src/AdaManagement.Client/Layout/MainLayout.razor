@inherits LayoutComponentBase
@implements IDisposable
@inject ThemeService Themes

<MudThemeProvider Theme="Themes.Current.MudTheme" IsDarkMode="Themes.Current.IsDark" />
<MudPopoverProvider />
<MudDialogProvider MaxWidth="MaxWidth.Small" FullWidth="true" CloseButton="true" />
<MudSnackbarProvider />

<AnimatedBackground />

<div class="@($"app-root {Themes.CssClass}")">
    <MudLayout>
        <MudAppBar Elevation="0" Dense="true">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="() => _drawer = !_drawer" aria-label="Menü" />
            <MudText Typo="Typo.h6" Class="ml-2 app-title">Ada</MudText>
            <MudSpacer />
            <MudMenu Icon="@Icons.Material.Outlined.Palette" Color="Color.Inherit" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight"
                     Dense="true" aria-label="Téma">
                <MudText Typo="Typo.overline" Class="px-4">Téma</MudText>
                @foreach (var t in ThemeService.All)
                {
                    <MudMenuItem OnClick="() => Themes.SetThemeAsync(t.Id)"
                                 Icon="@(Themes.Current.Id == t.Id ? Icons.Material.Filled.RadioButtonChecked : Icons.Material.Filled.RadioButtonUnchecked)">
                        @t.Name
                    </MudMenuItem>
                }
                <MudDivider Class="my-1" />
                <MudText Typo="Typo.overline" Class="px-4">Háttér</MudText>
                @foreach (var (value, label) in AnimationOptions)
                {
                    <MudMenuItem OnClick="() => Themes.SetAnimationAsync(value)"
                                 Icon="@(Themes.Animation == value ? Icons.Material.Filled.RadioButtonChecked : Icons.Material.Filled.RadioButtonUnchecked)">
                        @label
                    </MudMenuItem>
                }
            </MudMenu>
        </MudAppBar>

        <MudDrawer @bind-Open="_drawer" Elevation="0" Variant="DrawerVariant.Responsive" ClipMode="DrawerClipMode.Always">
            <MudNavMenu>
                <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Áttekintés</MudNavLink>
                <MudNavLink Href="ismetlodo" Icon="@Icons.Material.Filled.EventRepeat">Ismétlődő feladatok</MudNavLink>
                <MudNavLink Href="szuletesnapok" Icon="@Icons.Material.Filled.Cake">Születésnapok</MudNavLink>
                <MudNavLink Href="kesz" Icon="@Icons.Material.Filled.TaskAlt">Kész feladatok</MudNavLink>
                <MudNavLink Href="beallitasok" Icon="@Icons.Material.Filled.Settings">Beállítások</MudNavLink>
            </MudNavMenu>
            <MudDivider Class="my-2" />
            <form method="post" action="/account/logout" class="px-4">
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Logout" Size="Size.Small">Kilépés</MudButton>
            </form>
        </MudDrawer>

        <MudMainContent>
            <MudContainer MaxWidth="MaxWidth.Large" Class="@($"py-3 px-2 px-sm-4 {(HasBottomNav ? "with-bottom-nav" : "")}")">
                @Body
            </MudContainer>
        </MudMainContent>
    </MudLayout>

    @if (HasBottomNav)
    {
        <MudHidden Breakpoint="Breakpoint.SmAndDown" Invert="true">
            <nav class="bottom-nav">
                <NavLink href="" Match="NavLinkMatch.All" aria-label="Áttekintés"><MudIcon Icon="@Icons.Material.Outlined.GridView" /></NavLink>
                <NavLink href="ismetlodo" aria-label="Ismétlődő"><MudIcon Icon="@Icons.Material.Outlined.EventRepeat" /></NavLink>
                <NavLink href="szuletesnapok" aria-label="Születésnapok"><MudIcon Icon="@Icons.Material.Outlined.Cake" /></NavLink>
                <NavLink href="kesz" aria-label="Kész"><MudIcon Icon="@Icons.Material.Outlined.TaskAlt" /></NavLink>
                <NavLink href="beallitasok" aria-label="Beállítások"><MudIcon Icon="@Icons.Material.Outlined.Settings" /></NavLink>
            </nav>
        </MudHidden>
    }
</div>

@code {
    private bool _drawer;

    public static readonly (BackgroundAnimation Value, string Label)[] AnimationOptions =
    [
        (BackgroundAnimation.Hangulat, "Hangulat (témához illő)"),
        (BackgroundAnimation.Idojaras, "Időjárás szerint"),
        (BackgroundAnimation.Ki, "Kikapcsolva"),
    ];

    private bool HasBottomNav => Themes.Current.Layout == MatrixLayout.Fulek;

    protected override async Task OnInitializedAsync()
    {
        Themes.Changed += OnThemeChanged;
        await Themes.LoadAsync();
    }

    private void OnThemeChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Themes.Changed -= OnThemeChanged;
}
